PORT=3000

# ===== AI ADVISOR CONFIGURATION (OpenRouter) =====
# Получи ключ на https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-...your_key_here

# Model options:
# - openrouter/auto (smart routing, recommended)
# - google/gemini-2.0-flash-001 (fast, good for university recommendations)
# - meta-llama/llama-2-70b-chat (open source, good quality)
# - mistralai/mistral-7b-instruct (fast, lightweight)
OPENROUTER_MODEL=openrouter/auto

# Base URL (optional, defaults to https://openrouter.ai/api/v1)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ===== DEPRECATED (удалено в Stage 2) =====
# GEMINI_API_KEY больше не используется

