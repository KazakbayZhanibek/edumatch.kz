{
  "name": "edumatch-kz",
  "version": "1.0.0",
  "description": "EduMatch KZ - University admission prediction system for Kazakhstan",
  "main": "backend/server.js",
  "scripts": {
    "start": "cd backend && node server.js",
    "dev": "cd backend && node server.js",
    "seed": "cd backend && node scripts/seed-admission-stats.js",
    "db:init": "cd backend && node scripts/load-full-data.js",
    "db:backup": "cd backend && node scripts/backup-db.js",
    "db:rollback": "cd backend && node scripts/rollback-db.js",
    "db:audit": "cd backend && node scripts/audit-mvp-data.js",
    "data:pending": "cd backend && node scripts/export-pending-universities.js",
    "data:import": "cd backend && node scripts/import-verified-universities.js",
    "data:official-directory": "cd backend && node scripts/import-official-university-directory.js",
    "data:batch": "cd backend && node scripts/import-verified-batch.js",
    "data:rich-batch": "cd backend && node scripts/import-rich-university-batch.js",
    "security:audit": "cd backend && node scripts/audit-secrets.js",
    "admin:grant": "npm --prefix backend run admin:grant --",
    "test": "npm --prefix backend test"
  },
  "keywords": [
    "education",
    "universities",
    "admission",
    "kazakhstan"
  ],
  "author": "EduMatch Team",
  "license": "ISC",
  "engines": {
    "node": ">=14.0.0"
  }
}
